{
  "name": "ai-bouncer-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && echo 'web quality checks passed'",
    "test": "tsx --test tests/**/*.test.ts && echo 'web tests passed'",
    "verify:build": "next build && echo 'web production build passed'",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.2.6",
    "@fontsource/oxanium": "5.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
